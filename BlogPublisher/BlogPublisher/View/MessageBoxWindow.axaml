<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="BlogPublisher.View.MessageBoxWindow"
        Title="提示" Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Name="TxtMessage" TextWrapping="Wrap" FontSize="14" Text="Message" />
        <Button Name="BtnOk" Content="确定" Width="80" HorizontalAlignment="Right" Click="BtnOk_OnClick"/>
    </StackPanel>
</Window>
